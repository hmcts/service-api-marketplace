  <!--Azure Identity CVEs fixed long before the version in use-->
  <suppress>
    <notes>CVE-2023-36415 was fixed in azure-identity 1.10.1; this build resolves 1.18.7</notes>
    <packageUrl regex="true">^pkg:maven/com\.azure/azure\-identity@.*$</packageUrl>
    <cve>CVE-2023-36415</cve>
  </suppress>
  <suppress>
    <notes>CVE-2024-35255 was fixed in azure-identity 1.12.2 and msal4j 1.15.1; this build resolves
      1.18.7 and 1.26.0</notes>
    <packageUrl regex="true">^pkg:maven/(com\.azure/azure\-identity|com\.microsoft\.azure/msal4j.*)@.*$</packageUrl>
    <cve>CVE-2024-35255</cve>
  </suppress>
  <!--Key Vault Keys is not on the classpath. The CVE carries the blanket
      cpe:2.3:a:microsoft:azure_sdk_for_java CPE with versionEndExcluding 4.10.6, which matches
      every Azure SDK jar whatever its own version, so this is scoped by CVE across the group
      rather than to one artifact.-->
  <suppress>
    <notes>CVE-2026-33117 is in azure-security-keyvault-keys, which this service does not depend on</notes>
    <packageUrl regex="true">^pkg:maven/com\.(azure|microsoft\.azure).*/.*@.*$</packageUrl>
    <cve>CVE-2026-33117</cve>
