#!groovy

@Library("Infrastructure@2.15.0")

def type = "java"
def product = "amp"
def component = "marketplace"

// Gradle's HTML report for a stage's tests, as a link on the build next to the web's reports
def publishTestReport(String task, String name) {
  publishHTML target: [
    allowMissing          : true,
    alwaysLinkToLastBuild : true,
    keepAll               : true,
    reportDir             : "build/reports/tests/${task}",
    reportFiles           : 'index.html',
    reportName            : name,
  ]
}

withPipeline(type, product, component) {
  disableLegacyDeployment()

  afterAlways('smoketest:preview') {
    publishTestReport('smoke', 'Smoke Test Report')
  }

  afterAlways('smoketest:aat') {
    publishTestReport('smoke', 'Smoke Test Report')
  }

  afterAlways('functionalTest:preview') {
    publishTestReport('functional', 'Functional Test Report')
  }

  afterAlways('functionalTest:aat') {
    publishTestReport('functional', 'Functional Test Report')
  }

  // Flux takes the promoted image to AAT a few minutes later, so the web's journeys are started
  // against it then: a service change that breaks the site is caught within the hour, not the next
  // morning. The run reports to #amp-ci-alerts and doesn't hold up or fail this build.
  afterSuccess('prod:promotion') {
    build job: 'HMCTS_j_to_z_Nightly/web-api-marketplace/master',
      parameters: [booleanParam(name: 'AFTER_SERVICE_DEPLOY', value: true)],
      quietPeriod: 900,
      wait: false,
      propagate: false
  }
}
