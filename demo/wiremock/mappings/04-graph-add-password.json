{
  "name": "Graph: add a client secret - by object id (new application) or by appId (an older one)",
  "request": {
    "method": "POST",
    "urlPathPattern": "/graph/applications(/[^/]+|\\(appId='[^']+'\\))/addPassword"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"keyId\":\"{{randomValue type='UUID'}}\",\"secretText\":\"demo~{{randomValue length=34 type='ALPHANUMERIC'}}\"}"
  }
}
