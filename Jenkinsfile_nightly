#!groovy

properties([
  // H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
  pipelineTriggers([cron('H 07 * * 1-5')]),
  parameters([
    // The AAT staging release, whose private DNS record the pipeline registers. The long-lived
    // release's host, amp-marketplace.aat.platform.hmcts.net, has no private DNS record
    string(name: 'URL_TO_TEST', defaultValue: 'https://amp-marketplace-staging.aat.platform.hmcts.net', description: 'The URL you want to run these tests against'),
    string(name: 'SecurityRules',
      defaultValue: 'https://raw.githubusercontent.com/hmcts/security-test-rules/master/conf/security-rules.conf',
      description: 'Security rules config'),
  ]),
])

@Library("Infrastructure@2.13.4")

def type = "java"
def product = "amp"
def component = "marketplace"

withNightlyPipeline(type, product, component) {
  env.TEST_URL = params.URL_TO_TEST
  env.SecurityRules = params.SecurityRules
  enableSecurityScan()

  // Fortify on Demand static scan. It uses the platform's FoD credential, so our vault needs no FoD
  // secrets, and finds the FoD release by repo name. The vault is named because the library's
  // default, amp-aat, is the name from before the rename. Needs the library release with
  // cnp-jenkins-library#1602, which stops a vault without FoD secrets failing the nightly
  enableFortifyScan('amp-marketplace-aat')
}
