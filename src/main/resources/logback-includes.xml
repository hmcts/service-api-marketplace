<?xml version="1.0" encoding="UTF-8"?>
<!-- java-logging's default console pattern plus the MDC (correlationId). -->
<included>
    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] %logger{50}%ex{50} %msg%replace( [%mdc]){' \[\]', ''}%n}"/>
</included>
